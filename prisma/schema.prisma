
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Timer{
  id String @id @default(uuid())
  name String
  hours Int @default(0)
  minutes Int @default(0)
  seconds Int @default(0)
}
model Course{
  id String @id @default(uuid())
  name String
  initTime DateTime @db.Time(0)
  finalTime DateTime @db.Time(0)
}
