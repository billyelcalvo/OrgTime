
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Timer{
  id String @id @default(uuid())
  hours int @default(0)
  minutes int @default(0)
  seconds int @default(0)
}
model Course{
  id String @id @default(uuid())
  name
  initTime Int
  finalTime Int

  notification Notification
}
model Notification{
  id String id @default(uuid())
  idCourse String

  course Course @relation( fields: [idCourse], references:[id] )  
}