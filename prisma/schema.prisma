
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Timer{
  id String @id @default(uuid())
  name String
  hours Int @default(0)
  minutes Int @default(0)
  seconds Int @default(0)
  userId String

  user User @relation(fields: [userId], references: [id])

}
model Course{
  id String @id @default(uuid())
  name String
  initTime DateTime @db.Time(0)
  finalTime DateTime @db.Time(0)
  userId String

  user User @relation(fields: [userId], references: [id])
}
model User{
  id String @id @default(uuid())
  name String 
  email String @unique
  password String @Db.Varchar(72)
  course Course[]
  timer Timer[]
}